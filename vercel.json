{
  "rewrites": [
    {
      "source": "/karaoke/:hash",
      "destination": "/karaoke.html"
    },
    {
      "source": "/song/:videoId",
      "destination": "/api/song/:videoId"
    },
    {
      "source": "/download",
      "destination": "/download.html"
    },
    {
      "source": "/introduction",
      "destination": "/introduction.html"
    },
    {
      "source": "/tutorial",
      "destination": "/tutorial.html"
    }
  ],
  "redirects": [
    {
      "source": "/introduction.html",
      "destination": "/introduction",
      "permanent": true
    },
    {
      "source": "/tutorial.html",
      "destination": "/tutorial",
      "permanent": true
    },
    {
      "source": "/help.html",
      "destination": "/tutorial",
      "permanent": false
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/guide/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/current-version.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(script\\.js|style\\.css|ui-system\\.css|all\\.min\\.css|karaoke-encoder\\.js|favicon\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/billboard(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cwhxanbpymkngzpbsshh.supabase.co https://raw.githubusercontent.com https://www.googleapis.com https://www.youtube.com; img-src 'self' data: https:; font-src 'self' data:; frame-src https://www.youtube.com;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "browsing-topics=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; font-src * data: blob:; img-src * data: blob:; connect-src *; frame-src *; media-src * blob:;"
        }
      ]
    }
  ]
}
